{
  "name": "ng-lab-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "dev": "npm run db:up && concurrently --kill-others-on-fail --names api,client --prefix-colors cyan,magenta \"npm run api\" \"npm start\"",
    "ng": "npm --prefix client run ng --",
    "start": "npm --prefix client start --",
    "build": "npm --prefix client run build --",
    "watch": "npm --prefix client run watch --",
    "test": "npm --prefix client test --",
    "api": "npm --prefix server run dev",
    "api:test": "npm run db:test:up && npm --prefix server run test",
    "mail:up": "docker compose up -d --wait mailpit",
    "mail:down": "docker compose stop mailpit",
    "mail:test": "node --test test/mailpit.test.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$APP_DB_USER\" -d \"$POSTGRES_DB\"'",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:generate": "npm --prefix server run db:generate",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed --",
    "db:test:up": "docker compose up -d --wait db-test",
    "db:test:down": "docker compose rm -sf db-test"
  },
  "devDependencies": {
    "concurrently": "10.0.7"
  }
}
