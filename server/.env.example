DATABASE_URL=postgres://nglab_app:<APP_DB_PASSWORD>@127.0.0.1:5433/nglab
MIGRATION_DATABASE_URL=postgres://nglab_admin:<POSTGRES_PASSWORD>@127.0.0.1:5433/nglab

# Optional API settings (defaults shown)
# PORT=3000
# HOST=127.0.0.1
# CORS_ORIGIN=http://localhost:4200
# APP_URL=http://localhost:4200
# LOG_LEVEL=info

