meta {
  name: Log in - wrong password
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "ada@example.com",
    "password": "not the password"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq invalid_credentials
}

docs {
  An unknown email and a user without an account give the same response. Failed attempts are rate limited.
}
