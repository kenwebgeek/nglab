meta {
  name: Update user - invalid id
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/users/abc
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Nobody",
    "lastName": "Here",
    "email": "nobody-here@example.com"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq invalid_id
}
