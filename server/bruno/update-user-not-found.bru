meta {
  name: Update user - not found
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/users/2147483647
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Nobody",
    "lastName": "Here",
    "email": "nobody-here@example.com"
  }
}

assert {
  res.status: eq 404
  res.body.error: eq not_found
}
